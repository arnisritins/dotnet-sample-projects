@using System.Security.Claims
@model KindeAuth.Net48.Web.Models.UserModel
@{
    ViewBag.Title = "Profile";
}

<h1>Profile</h1>
<p>Welcome <strong>@Model.Name</strong>! This is your profile page.</p>

<table style="text-align: left;">
    <tr>
        <th>User ID</th>
        <td>@Model.UserID</td>
    </tr>
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>First Name</th>
        <td>@Model.FirstName</td>
    </tr>
    <tr>
        <th>Last Name</th>
        <td>@Model.LastName</td>
    </tr>
    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>
</table>
